{
	"name": "@curry-battle/react-multiple-video-manager",
	"version": "0.1.0",
	"description": "Headless React library for managing multiple videos with thumbnail support. Works with React Hook Form and TanStack Form via Ports & Adapters.",
	"keywords": [
		"react",
		"video",
		"form",
		"react-hook-form",
		"tanstack-form",
		"thumbnail",
		"headless",
		"multiple-upload"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/curry-battle/react-multiple-video-form-manager.git",
		"directory": "packages/react-multiple-video-manager"
	},
	"homepage": "https://github.com/curry-battle/react-multiple-video-form-manager#readme",
	"bugs": "https://github.com/curry-battle/react-multiple-video-form-manager/issues",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./react-hook-form": {
			"import": {
				"types": "./dist/react-hook-form/index.d.mts",
				"default": "./dist/react-hook-form/index.mjs"
			},
			"require": {
				"types": "./dist/react-hook-form/index.d.cts",
				"default": "./dist/react-hook-form/index.cjs"
			}
		},
		"./tanstack-form": {
			"import": {
				"types": "./dist/tanstack-form/index.d.mts",
				"default": "./dist/tanstack-form/index.mjs"
			},
			"require": {
				"types": "./dist/tanstack-form/index.d.cts",
				"default": "./dist/tanstack-form/index.cjs"
			}
		},
		"./schemas/zod": {
			"import": {
				"types": "./dist/schemas/zod.d.mts",
				"default": "./dist/schemas/zod.mjs"
			},
			"require": {
				"types": "./dist/schemas/zod.d.cts",
				"default": "./dist/schemas/zod.cjs"
			}
		},
		"./schemas/valibot": {
			"import": {
				"types": "./dist/schemas/valibot.d.mts",
				"default": "./dist/schemas/valibot.mjs"
			},
			"require": {
				"types": "./dist/schemas/valibot.d.cts",
				"default": "./dist/schemas/valibot.cjs"
			}
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"README.ja.md"
	],
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	},
	"scripts": {
		"build": "tsdown && pnpm run verify:isolation",
		"prepack": "cp ../../LICENSE .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"verify:isolation": "node ./scripts/check-bundle-isolation.mjs",
		"prepublishOnly": "pnpm run build"
	},
	"peerDependencies": {
		"@tanstack/react-form": "^1.33",
		"react": "^19",
		"react-hook-form": "^7.50",
		"valibot": "^1.0.0",
		"zod": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/react-form": {
			"optional": true
		},
		"react-hook-form": {
			"optional": true
		},
		"zod": {
			"optional": true
		},
		"valibot": {
			"optional": true
		}
	},
	"devDependencies": {
		"@hookform/resolvers": "5.4.0",
		"@tanstack/form-core": "1.33.2",
		"@tanstack/react-form": "1.33.2",
		"@types/react": "19.2.17",
		"@vitejs/plugin-react": "6.0.3",
		"@vitest/browser": "4.1.10",
		"@vitest/browser-playwright": "4.1.10",
		"@vitest/coverage-v8": "4.1.10",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "7.82.0",
		"tsdown": "0.22.12",
		"typescript": "7.0.2",
		"valibot": "1.4.2",
		"vitest": "4.1.10",
		"vitest-browser-react": "2.2.0",
		"zod": "4.4.3"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	}
}
